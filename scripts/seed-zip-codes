#!/usr/bin/env bash
# Download and import the full GeoNames US zip code dataset (~41k rows).
# Backs up the database first and validates the import; see
# db/scripts/load_zipcodes.sh for the monthly refresh workflow.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec "$SCRIPT_DIR/../db/scripts/load_zipcodes.sh" "$@"
