package templates

import (
	"fmt"
	"strconv"
)

// ErrorPage renders a full-page error with a styled body. It is used for 404s,
// 500s, and any other status where the user should not see the raw response.
templ ErrorPage(status int, heading, message string) {
	@profileShell(fmt.Sprintf("%s - Traditional Builders", heading)) {
		<section class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
			<div class="text-center py-16">
				<div class="text-6xl mb-6">🏛️</div>
				<p class="text-sm font-medium uppercase tracking-wide text-stone-400 dark:text-stone-500 mb-2">
					{ strconv.Itoa(status) }
				</p>
				<h2 class="text-2xl font-serif font-bold text-stone-900 dark:text-stone-100 mb-4">
					{ heading }
				</h2>
				<p class="text-stone-600 dark:text-stone-300 mb-8 max-w-lg mx-auto">
					{ message }
				</p>
				<a href="/" class="inline-block bg-leather-700 dark:bg-stone-700 text-cream-100 px-8 py-3 rounded-lg hover:bg-leather-600 dark:hover:bg-stone-600 font-medium transition-colors">
					Return Home
				</a>
			</div>
		</section>
	}
}
